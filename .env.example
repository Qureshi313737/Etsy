# Copy to .env for running on your own computer. NEVER commit .env.
# On GitHub, put the same names in Settings > Secrets and variables > Actions.

# --- Etsy (required) - https://www.etsy.com/developers/your-apps
ETSY_API_KEY=            # "Keystring"
ETSY_SHARED_SECRET=      # "Shared secret"
ETSY_REFRESH_TOKEN=      # printed by: python -m etsy_engine auth etsy
ETSY_REDIRECT_URI=http://localhost:3003/callback
ETSY_SHOP_ID=            # optional, auto-detected

# --- Token store (required for GitHub Actions) - python -m etsy_engine gen-key
TOKEN_ENCRYPTION_KEY=

# --- Pinterest API (optional) - https://developers.pinterest.com/apps/
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN= # printed by: python -m etsy_engine auth pinterest
PINTEREST_REDIRECT_URI=http://localhost:3003/callback

# --- AI copywriter (optional, free tiers)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys
ANTHROPIC_API_KEY=       # paid, optional

# --- Daily report on your phone (optional, free)
TELEGRAM_BOT_TOKEN=      # from @BotFather
TELEGRAM_CHAT_ID=

# --- Email report (optional) - Gmail needs an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
